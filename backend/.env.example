# Copie este arquivo para .env (na mesma pasta) e preencha com os seus dados.
# O .env esta no .gitignore: a senha nao vai para o GitHub.
# Na Vercel, cadastre as mesmas variaveis em Settings > Environment Variables.
# Os nomes precisam ser exatamente estes (maiusculas, sem espacos antes ou depois).
DB_USER=rm000000
DB_PASSWORD=sua_senha
